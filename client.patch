From: 3sx-fistbump-server
Subject: [PATCH] Wire matchmaking server params (Fase 4 testing)

Calls Netplay_SetMatchmakingParams() during Main_Init() so the netplay
menu can actually start matchmaking. Default points at localhost:9000.

Override at build time with -DFISTBUMP_HOST="..." -DFISTBUMP_PORT=...
or at runtime via env vars FISTBUMP_HOST / FISTBUMP_PORT.

---
 src/main.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/main.c b/src/main.c
--- a/src/main.c
+++ b/src/main.c
@@ -23,6 +23,9 @@
 #include "sf33rd/Source/Game/system/sys_sub2.h"
 #include "sf33rd/Source/Game/system/work_sys.h"
 #include "sf33rd/Source/PS2/mc/knjsub.h"
 #include "sf33rd/Source/PS2/mc/mcsub.h"
 #include "structs.h"
+#if NETPLAY_ENABLED
+#include "platform/netplay/netplay.h"
+#include <stdlib.h>
+#endif
@@ -100,6 +103,28 @@
 void Main_Init() {
     flInitialize();
     flSetRenderState(FLRENDER_BACKCOLOR, 0);
     system_init_level = 0;
     ppgWorkInitializeApprication();
     distributeScratchPadAddress();
     njdp2d_init();
     njUserInit();
     palCreateGhost();
     ppgMakeConvTableTexDC();
     appSetupBasePriority();
+
+#if NETPLAY_ENABLED
+    {
+#ifndef FISTBUMP_HOST
+#define FISTBUMP_HOST "127.0.0.1"
+#endif
+#ifndef FISTBUMP_PORT
+#define FISTBUMP_PORT 9000
+#endif
+        const char* host_env = getenv("FISTBUMP_HOST");
+        const char* port_env = getenv("FISTBUMP_PORT");
+        static char host_buf[128];
+        const char* host = host_env ? host_env : FISTBUMP_HOST;
+        int port = port_env ? atoi(port_env) : FISTBUMP_PORT;
+        SDL_strlcpy(host_buf, host, sizeof(host_buf));
+        Netplay_SetMatchmakingParams(host_buf, port);
+        SDL_Log("Fistbump matchmaking server: %s:%d\n", host_buf, port);
+    }
+#endif
 }
