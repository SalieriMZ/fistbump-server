+    int hp2 = (vit[1].cyerw * 100) / 160;
+    if (hp1 < 0) hp1 = 0; if (hp1 > 100) hp1 = 100;
+    if (hp2 < 0) hp2 = 0; if (hp2 > 100) hp2 = 100;
+    Fistbump_SendState(mr->match_id, hp1, hp2, Round_num, My_char[0], My_char[1]);
+}
