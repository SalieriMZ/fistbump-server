# Copy to publish_update.env and `source` before running publish_update.sh.

# SSH login for the server hosting the manifest files.
export HOST=ubuntu@fistbump.example.com

# Public base URL the launcher hits to download zips. Without a reverse proxy
# this is http://<host>:<stats-port>, with one (recommended) it's https://....
export PUBLIC_BASE_URL=https://fistbump.example.com

# Optional overrides:
# export SSH_KEY=$HOME/.ssh/fistbump
# export REMOTE_DIR=/opt/fistbump
